modules = ["python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "playwright-driver", "postgresql", "swig", "xcbuild", "nss", "atk", "at-spi2-atk", "cairo", "cups", "dbus", "expat", "gdk-pixbuf", "glib", "gtk3", "libdrm", "libxkbcommon", "mesa", "pango", "wayland", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "alsa-lib", "libgbm"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn src.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
BRIGHTDATA_ENABLED = "true"
BRIGHTDATA_LINKEDIN_JOBS_INPUTS_JSON = "[{\"location\":\"Philippines\",\"keyword\":\"DevOps\",\"country\":\"PH\",\"time_range\":\"Past 24 hours\",\"job_type\":\"\",\"experience_level\":\"Entry level\",\"remote\":\"\",\"company\":\"\",\"selective_search\":false,\"jobs_to_not_include\":[],\"location_radius\":\"\"},{\"location\":\"Philippines\",\"keyword\":\"Cloud\",\"country\":\"PH\",\"time_range\":\"Past 24 hours\",\"job_type\":\"\",\"experience_level\":\"Entry level\",\"remote\":\"\",\"company\":\"\",\"selective_search\":false,\"jobs_to_not_include\":[],\"location_radius\":\"\"},{\"location\":\"Philippines\",\"keyword\":\"IT Support\",\"country\":\"PH\",\"time_range\":\"Past 24 hours\",\"job_type\":\"\",\"experience_level\":\"Entry level\",\"remote\":\"\",\"company\":\"\",\"selective_search\":false,\"jobs_to_not_include\":[],\"location_radius\":\"\"}]"
